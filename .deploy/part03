/* ===== Irregular complexity labels around the magic orb ===== */
.magic-orb{
  overflow:visible !important;
}

/* 不再整圈旋转；标签像复杂问题一样散落在中心周围 */
#complexityOrbit{
  position:absolute;
  inset:-145px !important;
  animation:none !important;
  transform:none !important;
  pointer-events:none;
}

/* 每个标签独立轻微漂浮，不规则、不同角度、不同远近 */
#complexityOrbit .rune{
  position:absolute !important;
  font-size:13px;
  padding:10px 15px;
  border-radius:999px;
  background:rgba(255,255,255,.96);
  color:#526881;
  border:1px solid #DDE5EF;
  box-shadow:0 10px 26px rgba(13,27,52,.06);
  transform-origin:center;
  animation:labelFloat 4.8s ease-in-out infinite;
}

/* 位置参考：围绕中心不规则散开，而不是等距圆环 */
#complexityOrbit .r1{left:4%; top:5%; transform:rotate(-4deg)}
#complexityOrbit .r2{left:39%; top:2%; transform:rotate(3deg); animation-delay:.5s}
#complexityOrbit .r3{right:8%; top:4%; transform:rotate(7deg); animation-delay:1s}
#complexityOrbit .r4{left:1%; top:34%; transform:rotate(-6deg); animation-delay:1.4s}
#complexityOrbit .r5{right:-1%; top:31%; transform:rotate(5deg); animation-delay:.8s}
#complexityOrbit .r6{right:-6%; top:58%; transform:rotate(-3deg); animation-delay:1.8s}
#complexityOrbit .r7{left:-3%; bottom:7%; transform:rotate(-7deg); animation-delay:1.2s}
#complexityOrbit .r8{right:10%; bottom:4%; transform:rotate(4deg); animation-delay:2.1s}
#complexityOrbit .r9{left:22%; bottom:-2%; transform:rotate(2deg); animation-delay:.4s}
#complexityOrbit .r10{left:8%; top:58%; transform:rotate(5deg); animation-delay:1.6s}
#complexityOrbit .r11{right:20%; top:19%; transform:rotate(-5deg); animation-delay:.7s}
#complexityOrbit .r12{left:45%; bottom:2%; transform:rotate(-2deg); animation-delay:2.4s}

@keyframes labelFloat{
  0%,100%{margin-top:0}
  50%{margin-top:-7px}
}

/* 收拢时暂停漂浮，所有标签向中心吸入 */
.magic-orb.collapsed #complexityOrbit .rune{
  animation:none !important;
  transform:
    translate(var(--collapse-x,0px),var(--collapse-y,0px))
    scale(.16)
    rotate(0deg) !important;
  opacity:0 !important;
  filter:blur(3px);
}

/* 让中央区域更像参考图：三层柔和粉色光环 */
.magic-orb{
  box-shadow:
    0 0 0 34px rgba(255,64,145,.055),
    0 0 0 72px rgba(255,64,145,.035),
    0 0 90px rgba(255,64,145,.18),
    inset 0 0 70px rgba(255,255,255,.48) !important;
}
.magic-orb:before{
  inset:-38px !important;
  border:1px solid rgba(255,64,145,.18) !important;
}
.magic-orb:after{
  inset:-82px !important;
  border:1px solid rgba(255,64,145,.10) !important;
}

/* 收拢后光环一起向中心收紧 */
.magic-orb.collapsed:before{inset:72px !important}
.magic-orb.collapsed:after{inset:102px !important}

