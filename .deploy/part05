  font-weight:900 !important;
  line-height:1 !important;
  min-width:18px !important;
  text-align:center !important;
}

/*
  真实“圆环式”分布：
  上 → 右上 → 右 → 右下 → 下右 → 下 → 下左 → 左 → 左上
  让左右数量视觉上均衡。
*/
#complexityOrbit .r1 {left:50% !important; top:4%  !important; animation-delay:.0s !important;}  /* 需求 */
