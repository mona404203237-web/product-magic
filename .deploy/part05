  white-space:nowrap !important;

  opacity:1 !important;
  filter:none !important;
  translate:0 0 !important;
  scale:1 !important;
  rotate:0deg !important;
  animation:orbitFloat 5s ease-in-out infinite !important;
  transform:translate(-50%,-50%) !important;
}

