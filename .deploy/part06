<div class="modal" id="modal"><div class="modalbox"><div class="modalhead"><div><div class="chapter" id="mk">MAGIC</div><h2 id="mt"></h2></div><button class="close" id="mx">×</button></div><div class="modalbody" id="mb"></div></div></div>

<script>
/* cursor magic */
const cur=document.getElementById('cursorSpell');
document.addEventListener('mousemove',e=>{
  cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px';
  if(Math.random()>.55){const t=document.createElement('i');t.className='trail';t.style.left=e.clientX+'px';t.style.top=e.clientY+'px';document.body.appendChild(t);setTimeout(()=>t.remove(),700)}
});

/* particles */
const canvas=document.getElementById('particles'),ctx=canvas.getContext('2d');let pts=[];
function resize(){canvas.width=innerWidth;canvas.height=document.querySelector('.hero').offsetHeight;pts=Array.from({length:90},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,r:Math.random()*1.8+.4,v:Math.random()*.25+.08}))}
resize();addEventListener('resize',resize);
function draw(){ctx.clearRect(0,0,canvas.width,canvas.height);ctx.fillStyle='rgba(255,64,145,.42)';pts.forEach(p=>{p.y-=p.v;if(p.y<0)p.y=canvas.height;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill()});requestAnimationFrame(draw)}draw();

/* modal */
const modal=document.getElementById('modal');function pop(k,t,b){mk.textContent=k;mt.textContent=t;mb.innerHTML=b;modal.classList.add('show')}mx.onclick=()=>modal.classList.remove('show');modal.onclick=e=>{if(e.target===modal)modal.classList.remove('show')};

/* hero interaction */
function burst(x,y){for(let i=0;i<24;i++){let s=document.createElement('i');s.className='trail';s.style.width='10px';s.style.height='10px';s.style.left=x+'px';s.style.top=y+'px';s.style.background=i%2?'#FF4091':'#8F235C';document.body.appendChild(s);let a=Math.random()*Math.PI*2,d=50+Math.random()*120;s.animate([{transform:'translate(0,0) scale(1)',opacity:1},{transform:`translate(${Math.cos(a)*d}px,${Math.sin(a)*d}px) scale(.1)`,opacity:0}],{duration:700+Math.random()*400});setTimeout(()=>s.remove(),1200)}}
const magicOrb=document.querySelector('.magic-orb');
const complexityRunes=[...document.querySelectorAll('#complexityOrbit .rune')];
let orbCollapsed=false;

function prepareCollapseVectors(){
  const orbRect=magicOrb.getBoundingClientRect();
  const cx=orbRect.left+orbRect.width/2;
  const cy=orbRect.top+orbRect.height/2;
  complexityRunes.forEach(r=>{
    const rr=r.getBoundingClientRect();
    const rx=rr.left+rr.width/2;
    const ry=rr.top+rr.height/2;
    r.style.setProperty('--collapse-x',(cx-rx)+'px');
    r.style.setProperty('--collapse-y',(cy-ry)+'px');
  });
}
function toggleProductMagic(e){
  burst(e.clientX,e.clientY);
  prepareCollapseVectors();
  orbCollapsed=!orbCollapsed;
  magicOrb.classList.toggle('collapsed',orbCollapsed);

}
orbCore.onclick=toggleProductMagic;
